        {
          "id": "w_sw_boot",
          "trigger": "event",
          "eventName": "app:boot",
          "mode": "js",
          "code": "var el=machine.el;var swatches=dbGet('swatches',[]);if(!el)return;el.innerHTML='';var badge=document.createElement('span');badge.className='badge';badge.textContent=machine.name;el.appendChild(badge);swatches.forEach(function(s,i){  var sw=document.createElement('div');sw.style.cssText='display:inline-flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;padding:6px;border-radius:10px;transition:background .1s';  sw.onmouseover=function(){sw.style.background='rgba(255,255,255,.07)'};  sw.onmouseout=function(){sw.style.background='transparent'};  var circle=document.createElement('div');circle.style.cssText='width:44px;height:44px;border-radius:50%;background:'+s.hex+';border:2px solid rgba(255,255,255,.2)';  var lbl=document.createElement('span');lbl.style.cssText='font-size:9px;color:#9da9c2;font-family:monospace';lbl.textContent=s.hex;  var del=document.createElement('button');del.style.cssText='background:transparent;border:none;color:#fb7185;cursor:pointer;font-size:11px;padding:0;line-height:1';del.textContent='×';  del.onclick=function(e){e.stopPropagation();var ss=dbGet('swatches',[]);ss.splice(i,1);dbSet('swatches',ss);};  circle.onclick=function(e){e.stopPropagation();var r=parseInt(s.hex.slice(1,3),16),g=parseInt(s.hex.slice(3,5),16),b=parseInt(s.hex.slice(5,7),16);dbSet('r',r);dbSet('g',g);dbSet('b',b);};  sw.appendChild(circle);sw.appendChild(lbl);sw.appendChild(del);el.appendChild(sw);});if(!swatches.length){var empty=document.createElement('span');empty.style.cssText='color:#9da9c2;font-size:13px;padding:10px';empty.textContent='No swatches saved yet';el.appendChild(empty);}"
        },
