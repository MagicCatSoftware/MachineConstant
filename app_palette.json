          "id": "w_save",
          "trigger": "click",
          "eventName": "palette:save",
          "mode": "js",
          "code": "var r=Math.round(dbGet('r',0)),g=Math.round(dbGet('g',0)),b=Math.round(dbGet('b',0));var hex='#'+[r,g,b].map(function(v){return v.toString(16).padStart(2,'0')}).join('');var ss=dbGet('swatches',[]);if(ss.some(function(s){return s.hex===hex})){log('Swatch already saved: '+hex);return;}ss.push({hex:hex,r:r,g:g,b:b});dbSet('swatches',ss);log('Saved swatch '+hex);"
