      "wires": [
        {
          "id": "w_list_boot",
          "trigger": "event",
          "eventName": "app:boot",
          "mode": "js",
          "code": "var el=machine.el;var todos=dbGet('todos',[]);if(!el)return;el.innerHTML='';var badge=document.createElement('span');badge.className='badge';badge.textContent=machine.name;el.appendChild(badge);todos.forEach(function(t,i){  var row=document.createElement('div');  row.style.cssText='padding:10px 14px;border-radius:10px;margin:5px 0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;gap:10px;cursor:pointer;'+(t.done?'opacity:.4;':'');  var icon=document.createElement('span');icon.style.cssText='font-size:17px;flex-shrink:0;color:'+(t.done?'#86efac':'#9da9c2');icon.textContent=t.done?'✓':'○';  var txt=document.createElement('span');txt.style.cssText='flex:1;font-size:14px;'+(t.done?'text-decoration:line-through;color:#9da9c2;':'color:white;');txt.textContent=t.text;  var del=document.createElement('button');del.style.cssText='background:transparent;border:none;color:#fb7185;cursor:pointer;font-size:15px;padding:2px 6px;flex-shrink:0';del.textContent='×';  del.onclick=function(e){e.stopPropagation();var ts=dbGet('todos',[]);ts.splice(i,1);dbSet('todos',ts);};  row.onclick=function(e){if(e.target===del)return;e.stopPropagation();var ts=dbGet('todos',[]);ts[i].done=!ts[i].done;dbSet('todos',ts);};  row.appendChild(icon);row.appendChild(txt);row.appendChild(del);el.appendChild(row);});if(!todos.length){  var empty=document.createElement('div');empty.style.cssText='color:#9da9c2;padding:14px;text-align:center;font-size:13px';  empty.textContent='No todos yet — add one above!';el.appendChild(empty);}"
        },
        {
          "id": "w_list_chg",
          "trigger": "event",
          "eventName": "db:changed",
          "mode": "js",
          "code": "var el=machine.el;var todos=dbGet('todos',[]);if(!el)return;el.innerHTML='';var badge=document.createElement('span');badge.className='badge';badge.textContent=machine.name;el.appendChild(badge);todos.forEach(function(t,i){  var row=document.createElement('div');  row.style.cssText='padding:10px 14px;border-radius:10px;margin:5px 0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;gap:10px;cursor:pointer;'+(t.done?'opacity:.4;':'');  var icon=document.createElement('span');icon.style.cssText='font-size:17px;flex-shrink:0;color:'+(t.done?'#86efac':'#9da9c2');icon.textContent=t.done?'✓':'○';  var txt=document.createElement('span');txt.style.cssText='flex:1;font-size:14px;'+(t.done?'text-decoration:line-through;color:#9da9c2;':'color:white;');txt.textContent=t.text;  var del=document.createElement('button');del.style.cssText='background:transparent;border:none;color:#fb7185;cursor:pointer;font-size:15px;padding:2px 6px;flex-shrink:0';del.textContent='×';  del.onclick=function(e){e.stopPropagation();var ts=dbGet('todos',[]);ts.splice(i,1);dbSet('todos',ts);};  row.onclick=function(e){if(e.target===del)return;e.stopPropagation();var ts=dbGet('todos',[]);ts[i].done=!ts[i].done;dbSet('todos',ts);};  row.appendChild(icon);row.appendChild(txt);row.appendChild(del);el.appendChild(row);});if(!todos.length){  var empty=document.createElement('div');empty.style.cssText='color:#9da9c2;padding:14px;text-align:center;font-size:13px';  empty.textContent='No todos yet — add one above!';el.appendChild(empty);}"
        }
